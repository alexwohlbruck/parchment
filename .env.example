# Database credentials
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password

# Server configuration
SERVER_ORIGIN=http://your_server_ip:5000
CLIENT_ORIGIN=http://your_server_ip:5173
# Reverse proxies in front of the API that append to X-Forwarded-For. Rate
# limits key on the client IP, so this must match: 0 when the API is exposed
# directly, 2 for Cloudflare in front of Caddy or nginx.
TRUSTED_PROXY_HOPS=1

# The next two server keys must be INDEPENDENT random values —
# do NOT use the same bytes for both. One is an Ed25519 signing seed
# whose public half is exposed at /.well-known/parchment-server; the other
# is an AES-256 symmetric key. Sharing bytes across signing + encryption
# primitives is a cryptographic anti-pattern. Generate two separate keys:
#
#     openssl rand -base64 32   # → SERVER_IDENTITY_PRIVATE_KEY
#     openssl rand -base64 32   # → PARCHMENT_INTEGRATION_ENCRYPTION_KEY

# Federation server identity (Ed25519 seed, base64-encoded 32 bytes).
# REQUIRED — the server refuses to start without this, in every environment.
# Persist this so your server identity is stable across restarts; rotation
# breaks TOFU pinning on every peer until they manually re-pin.
SERVER_IDENTITY_PRIVATE_KEY=

# Integration credential encryption key (AES-256 master key, base64-encoded 32 bytes).
# REQUIRED — the server refuses to start without this, in every environment.
# Encrypts third-party API keys / bearer tokens stored in the integrations
# table. Provide via whatever secrets mechanism your deploy uses; plain env
# var injection is fine. If you happen to run on AWS/GCP/Vault you can
# unseal from those services before startup and inject the 32 bytes as
# this env var, but no external key service is required.
PARCHMENT_INTEGRATION_ENCRYPTION_KEY=

# Email configuration (optional — if not set, OTP codes are logged to console)
# Works with any SMTP provider: Resend, SendGrid, Amazon SES, Gmail, etc.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Parchment <noreply@yourdomain.com>
APP_TESTER_EMAIL=your_test_email@gmail.com

# Self-hosting: grant every user full permissions without a subscription.
# Keep this 'true' when self-hosting — it is the supported way to unlock
# the full app. (Only takes effect when billing is not configured below.)
PARCHMENT_SELF_HOSTED=true

# Subscription billing (Parchment Cloud only — not for self-hosting).
# The hosted service at parchment.app uses Polar for subscriptions. Enabling
# billing requires a signed PARCHMENT_LICENSE issued only by the official
# Parchment build, so these variables have no effect on a self-hosted
# instance — leave them unset and use PARCHMENT_SELF_HOSTED above. They are
# listed here (commented out) only to document the interface.
# PARCHMENT_LICENSE=
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_ORGANIZATION_ID=
# POLAR_BASIC_PRODUCT_ID=
# POLAR_PREMIUM_PRODUCT_ID=
# POLAR_SANDBOX=false

# File storage for uploads like profile photos.
# 'local' (default) keeps files on the server's disk — no cloud account needed.
# 'r2' uses a Cloudflare R2 bucket with just an API token.
# 's3' uses any S3-compatible bucket: AWS S3, MinIO, Garage, B2, or R2 with S3 keys.
STORAGE_DRIVER=local
# Where 'local' writes files. The prod compose file points this at the data volume.
# STORAGE_LOCAL_DIR=data/uploads
# Optional: serve files straight from this origin (e.g. an R2 custom domain)
# instead of through the API at /files.
# STORAGE_PUBLIC_URL=https://files.yourdomain.com
# Required when STORAGE_DRIVER=r2: an R2 API token with Object Read & Write on
# S3_BUCKET. The S3 keys are derived from it. R2_ACCOUNT_ID is only needed when
# the token can see more than one account.
# R2_API_TOKEN=
# R2_ACCOUNT_ID=
# S3_BUCKET is required for both 'r2' and 's3'; the rest only for 's3'.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Registration mode: 'invite' (default, requires admin to create users) or 'open'
REGISTRATION_MODE=invite

# Docs site
NEXT_PUBLIC_CLIENT_ORIGIN=http://your_server_ip:5173
